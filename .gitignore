# ==============================================================================
# FloatBro Root .gitignore
# Covers: Android, Gradle, Jetpack Compose, NDK/CMake, IDEs, OS Caches, Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle & Build Caches
# ------------------------------------------------------------------------------
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# ------------------------------------------------------------------------------
# 2. Android & Compilation Artifacts
# ------------------------------------------------------------------------------
*.apk
*.ap_
*.aab
*.dex
*.class
captures/
.navigation/

# Android Lint reports and baselines
lint-results*
lint-baseline*.xml
**/build/reports/lint-results*

# Jetpack Compose Compiler Metrics & Reports
**/compose_metrics/
**/compose_metrics/**
**/compose_reports/
**/compose_reports/**

# ------------------------------------------------------------------------------
# 3. NDK / CMake / C++ Native Build Artifacts
# ------------------------------------------------------------------------------
.cxx/
**/.cxx/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json
**/*.ninja
**/.ninja_*
*.o
*.obj
*.a
*.so
*.dylib
*.dll

# ------------------------------------------------------------------------------
# 4. Local Environment & Secrets (STRICTLY PROHIBITED IN REPO)
# ------------------------------------------------------------------------------
local.properties
secrets.properties
*.jks
*.keystore
*.key
*.p12
*.pem
google-services.json
firebase-debug.json

# ------------------------------------------------------------------------------
# 5. IDE / Editor Configurations
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# 6. Operating System Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# 7. Temporary / Logs / Python Scripts
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
__pycache__/
*.py[cod]
*$py.class
scratch/
qa_evidence/

# ------------------------------------------------------------------------------
# 8. Internal Planning & Design Specs (Private Working Drafts)
# ------------------------------------------------------------------------------
*PLAN*.md
*SPEC*.md
docs/internal/

